auto-install-peers=true
strict-peer-dependencies=false
# Expo SDK 54's @expo/cli does `require.resolve('metro-runtime/...')` from its own
# location; pnpm's isolated store hides it. Hoist metro packages to the top-level
# node_modules so the Expo/Metro toolchain resolves them. The backend doesn't use
# metro, so this is inert for apps/api, packages/*.
public-hoist-pattern[]=*metro*
