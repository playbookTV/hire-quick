# Copy to .env and fill in real values. NEVER commit .env.

# Postgres. DATABASE_URL = pooled (app runtime); DIRECT_URL = direct (migrations).
# On Neon: DIRECT_URL host is the DATABASE_URL host with "-pooler" removed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NODE_ENV="development"
PORT="4000"
LOG_LEVEL="debug"

# Auth
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="2592000"

# Paystack TEST keys (Phase 2)
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_WEBHOOK_SECRET=""

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# Brevo — transactional SMS (OTP delivery) + email (notifications).
# Empty = dev stub (OTP codes echoed in the response on non-production).
BREVO_API_KEY=""
BREVO_SMS_SENDER="HireQuick"

# Worker process selector (Railway): set PROCESS_TYPE=worker on the worker service.
PROCESS_TYPE=""
