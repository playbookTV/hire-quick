# Copy to .env and fill in real values. NEVER commit .env.

# Postgres. DATABASE_URL = pooled (app runtime); DIRECT_URL = direct (migrations).
# On Neon: DIRECT_URL host is the DATABASE_URL host with "-pooler" removed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

NODE_ENV="development"
PORT="4000"
# Reverse-proxy hops in front of the app (Railway = 1; local/none = 0).
# Required behind a proxy so rate limiting keys on the real client IP.
TRUST_PROXY="0"
LOG_LEVEL="debug"

# Auth — local defaults only. Staging/production require distinct strong secrets.
JWT_ACCESS_SECRET="dev-access-secret"
JWT_REFRESH_SECRET="dev-refresh-secret"
JWT_ACCESS_TTL="900"
JWT_REFRESH_TTL="2592000"
# Managed random secret required in staging/production; local empty = ephemeral process key.
# Rotation and legacy-code reissue: documentation/otp-verifiers.md
OTP_VERIFIER_SECRET=""
OTP_VERIFIER_KEY_ID="v1"
OTP_VERIFIER_PREVIOUS_SECRET=""
OTP_VERIFIER_PREVIOUS_KEY_ID=""
# Optional six-digit code for the four seeded QA accounts; staging + Paystack test keys only.
STAGING_QA_OTP_CODE=""

# Paystack — use TEST keys for development. Empty does not enable a fake.
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Redis
REDIS_URL="redis://127.0.0.1:6379"

# Brevo — transactional SMS (OTP delivery) + email (notifications).
# Login codes are echoed only in isolated NODE_ENV=test; deployed/dev login requires delivery.
BREVO_API_KEY=""
BREVO_EMAIL_SENDER="no-reply@hirequick.app"
BREVO_SMS_SENDER="HireQuick"

# Worker process selector (Railway): set PROCESS_TYPE=worker on the worker service.
PROCESS_TYPE=""

# CORS allowlist (compliance). Comma-separated browser origins. Empty = reflect
# any origin (dev/test only) — production MUST set the admin SPA + mobile origins.
CORS_ORIGINS=""

# NDPR retention windows (days) for the daily purge job. Defaults shown.
RETENTION_OTP_DAYS="30"
RETENTION_DEVICE_TOKEN_DAYS="180"
RETENTION_KYC_VERIFIED_DAYS="90"
RETENTION_KYC_REJECTED_DAYS="30"
RETENTION_CHAT_DAYS="180"

# KYC document storage: Cloudflare R2 (S3-compatible). Empty bucket/creds =
# storage disabled (legacy URL passthrough). Endpoint:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com  — R2 requires region "auto".
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Full configuration and environment-loading instructions: docs/CONFIGURATION.md
# Optional commission sweep destination. Empty disables the scheduled sweep.
PAYSTACK_OPERATING_RECIPIENT=""
WITHDRAWAL_REQUIRE_BVN="false"

# WhatsApp OTP: sender + positive template ID select WhatsApp instead of SMS.
BREVO_WHATSAPP_SENDER=""
BREVO_WHATSAPP_OTP_TEMPLATE_ID="0"
BREVO_WHATSAPP_OTP_PARAM="code"

# Biometric KYC. App ID, secret, and widget required in staging/production.
DOJAH_APP_ID=""
KYC_MODE="dojah"
DOJAH_SECRET_KEY=""
DOJAH_WIDGET_ID=""
DOJAH_ENVIRONMENT="sandbox"

# Optional Firebase push; all three values required to enable real delivery.
# Configure the multiline private key in a secret manager for deployed services.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""
