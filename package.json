{
  "name": "hirequick",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "pnpm --filter @hq/api dev",
    "mobile": "turbo run dev --filter=@hq/mobile",
    "mobile:start": "pnpm --filter @hq/mobile start",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @hq/database generate",
    "db:push": "pnpm --filter @hq/database push",
    "db:migrate": "pnpm --filter @hq/database migrate",
    "db:deploy": "pnpm --filter @hq/database deploy",
    "db:seed": "pnpm --filter @hq/database seed",
    "db:studio": "pnpm --filter @hq/database studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"],
    "comment-overrides": "Dedupe @types/react to ONE copy so react-native + restyle + the mobile app share identical ReactNode types. Mixed copies intersect to a ReactNode missing bigint → children type errors. admin (React 18 runtime) compiles fine against these types. postcss/js-yaml pinned to patched same-major versions to clear transitive NDPR advisories (expo metro-config / babel-jest paths) without a risky major bump.",
    "overrides": {
      "@types/react": "19.1.10",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0"
    }
  },
  "devDependencies": {
    "@hq/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
