# Base URL of the running HireQuick API (apps/api, default :4000).
# - iOS simulator / web:        http://localhost:4000
# - Android emulator:           http://10.0.2.2:4000
# - Physical device (Expo Go):  http://<YOUR-MACHINE-LAN-IP>:4000  (e.g. http://192.168.1.20:4000)
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
EXPO_PUBLIC_API_URL=http://localhost:4000
