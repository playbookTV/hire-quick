# Base URL of the HireQuick API. EXPO_PUBLIC_* vars are inlined at build time.
# - Deployed API (requires configured OTP delivery and authorized test accounts):
#       https://prolific-love-production-2775.up.railway.app
# - Local API (apps/api, default :4000):
#     iOS simulator / web:       http://localhost:4000
#     Android emulator:          http://10.0.2.2:4000
#     Physical device (Expo Go): http://<YOUR-MACHINE-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional override. Release builds default to studio-templar/react-native.
# A blank DSN explicitly disables reporting; development builds never report.
# EXPO_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@HOST/PROJECT_ID
# EXPO_PUBLIC_APP_ENV=preview
# SENTRY_AUTH_TOKEN belongs in EAS secrets, NEVER an EXPO_PUBLIC_* variable.

# Crisp in-app support. This is a public Website ID, not an API key.
# Requires a native development/release build (not Expo Go).
EXPO_PUBLIC_CRISP_WEBSITE_ID=17beef2c-a56c-41de-8c96-4d7a233389e9

# Optional fallback for the in-app "Contact support" / "Help & support" actions.
# WhatsApp is preferred (E.164 digits, no "+"), email is the fallback. If both
# are empty the button shows an in-app notice instead of opening a channel.
# EXPO_PUBLIC_SUPPORT_WHATSAPP=2348012345678
# EXPO_PUBLIC_SUPPORT_EMAIL=support@hirequick.example
