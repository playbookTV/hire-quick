# Base URL of the HireQuick API. EXPO_PUBLIC_* vars are inlined at build time.
# - Deployed staging (seeded QA accounts + OTP echo → dev quick-login works):
#       https://prolific-love-production-2775.up.railway.app
# - Local API (apps/api, default :4000):
#     iOS simulator / web:       http://localhost:4000
#     Android emulator:          http://10.0.2.2:4000
#     Physical device (Expo Go): http://<YOUR-MACHINE-LAN-IP>:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Support contact for the in-app "Contact support" / "Help & support" actions.
# WhatsApp is preferred (E.164 digits, no "+"), email is the fallback. If both
# are empty the button shows an in-app notice instead of opening a channel.
# EXPO_PUBLIC_SUPPORT_WHATSAPP=2348012345678
# EXPO_PUBLIC_SUPPORT_EMAIL=support@hirequick.example
