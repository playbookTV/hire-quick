{
  "expo": {
    "name": "HireQuick",
    "slug": "hirequick",
    "scheme": "hirequick",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FBF7F0",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hirequick.mobile"
    },
    "android": {
      "package": "com.hirequick.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "HireQuick needs photo access so you can upload your ID for verification.",
          "cameraPermission": "HireQuick needs camera access so you can take a verification selfie."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
