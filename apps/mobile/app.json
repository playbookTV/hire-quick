{
  "expo": {
    "name": "HireQuick",
    "slug": "hirequick",
    "scheme": "hirequick",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FBF7F0",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hirequick.mobile"
    },
    "android": {
      "package": "com.hirequick.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
