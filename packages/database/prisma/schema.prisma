// HireQuick schema (TRD §6, v2.1). Money is integer **kobo** (Int) — never
// Decimal/float — so the ledger Σ==0 invariant (§25) holds exactly.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) for app runtime
  directUrl = env("DIRECT_URL") // direct for migrations + concurrency tests
}

// ---------- enums ----------
enum UserRole {
  CLIENT
  USHER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ANONYMIZED // NDPR erasure: PII scrubbed, financial records retained (TRD §14)
}

enum UsherVerifyState {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/** How an usher proved identity. BIOMETRIC = Dojah (NIN/BVN + liveness + face-match). */
enum VerificationMethod {
  DOCUMENT
  BIOMETRIC
}

/** Standardised rejection codes so reviewers don't free-type and analytics can group. */
enum VerificationRejectReason {
  UNCLEAR_ID
  SELFIE_MISMATCH
  LIVENESS_FAILED
  ID_NOT_FOUND
  NAME_MISMATCH
  WATCHLISTED
  EXPIRED_DOCUMENT
  POOR_IMAGE
  OTHER
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BUSY
}

enum EventStatus {
  DRAFT
  OPEN
  PARTIALLY_STAFFED
  FULLY_STAFFED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum InvitationStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CHECKED_IN
  COMPLETED
  PAID
  CANCELLED
  NO_SHOW
  DISPUTED
  REFUNDED
}

enum AttendanceMethod {
  OTP
  QR
  AUTO
}

enum OrderStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  FROZEN
}

enum LedgerEntryType {
  HOLD
  RELEASE
  REFUND
  FEE
  REVERSAL
  COMMISSION_SWEEP
}

enum WalletEntryType {
  CREDIT
  DEBIT
  REVERSAL
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum MessageContentType {
  TEXT
  IMAGE
  VOICE
}

enum CodePurpose {
  AUTH
  ATTENDANCE
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum ConsentPurpose {
  PUSH_NOTIFICATIONS
  MARKETING_EMAIL
  SMS
}

enum ConsentSource {
  EXPLICIT
  LEGITIMATE_INTEREST
}

enum ApprovalKind {
  DISPUTE_RESOLVE
  REFUND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

// Durable cross-system operation record (TRD §10/§17). Every Paystack call that
// must be paired with a ledger/state write flows through one of these so a crash
// between the provider call and the ledger write is resumable, and a concurrent
// retry is deduped by `dedupeKey` before the provider is ever called.
enum PaymentOpKind {
  BOOKING_REFUND
  WITHDRAWAL_TRANSFER
  COMMISSION_SWEEP
  APPROVAL_EXECUTE
}

enum PaymentOpStatus {
  PENDING // claimed; provider call not yet confirmed
  PROVIDER_OK // provider (Paystack) call succeeded; ledger not yet recorded
  RECORDED // ledger/state recorded — terminal success
  FAILED // provider reported failure — terminal
}

// Late-night safety disclosure on a job posting (visible to staff pre-accept).
enum Accommodation {
  PROVIDED
  NOT_PROVIDED
}

// Reward fulfilment mode for a milestone tier.
enum RewardType {
  BADGE // digital — auto-fulfilled on unlock
  PHYSICAL // dress, iPhone, etc — admin fulfils manually
}

enum MilestoneStatus {
  UNLOCKED
  FULFILLED
}

enum NotificationType {
  CHECKOUT_UPDATED
  INVITATION_RECEIVED
  APPLICATION_RECEIVED
  BOOKING_CONFIRMED
  PAYOUT_RELEASED
  NEW_MESSAGE
  DISPUTE_OPENED
}

// ---------- identity ----------
model User {
  id           String     @id @default(uuid()) @db.Uuid
  role         UserRole
  email        String?    @unique
  phone        String     @unique
  passwordHash String?
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6)
  anonymizedAt DateTime?  @db.Timestamptz(6) // set when an NDPR erasure scrubs this user's PII

  client            Client?
  usher             Usher?
  deviceTokens      DeviceToken[]
  reviewsAuthored   Review[]            @relation("ReviewAuthor")
  reviewsReceived   Review[]            @relation("ReviewSubject")
  disputesRaised    Dispute[]           @relation("DisputeRaisedBy")
  disputesResolved  Dispute[]           @relation("DisputeResolvedBy")
  verificationsDone UsherVerification[] @relation("VerificationReviewer")
  messagesSent      Message[]
  approvalsMade     Approval[]          @relation("ApprovalMaker")
  approvalsChecked  Approval[]          @relation("ApprovalChecker")
  notifications     Notification[]
  consents          ConsentRecord[]
  revokedTokens     RevokedToken[]
  policyAcceptances PolicyAcceptance[]

  @@map("users")
}

model Client {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @db.Uuid
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  businessName String? // optional company/brand name shown on the client profile
  ratingAvg    Float   @default(0)
  ratingCount  Int     @default(0)

  events Event[]
  orders Order[]

  @@map("clients")
}

model Usher {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String?
  bio                String?
  yearsExperience    Int              @default(0)
  verificationStatus UsherVerifyState @default(PENDING)
  verifiedAt         DateTime?        @db.Timestamptz(6) // when KYC last passed
  kycAttempts        Int              @default(0) // biometric attempts; caps resubmits
  reliabilityScore   Float            @default(100)
  ratingAvg          Float            @default(0)
  ratingCount        Int              @default(0)
  completedJobsCount Int              @default(0) // denormalized rank key; bumped on each completion
  avatarKey          String? // server-owned storage key for the profile photo; null = initials fallback
  state              String? // Nigerian state (e.g. "Lagos"); ushers only see jobs in their state
  city               String? // base area in Lagos (e.g. "Lekki"); powers the location discovery filter
  languages          String[]         @default([]) // spoken languages; powers the language discovery filter
  dayRateKobo        Int? // indicative day rate — display + discovery filter only; escrow math uses Event.budgetPerHead

  verifications UsherVerification[]
  photos        Photo[]
  availability  Availability[]
  applications  Application[]
  invitations   Invitation[]
  bookings      Booking[]
  wallet        Wallet?
  bankAccounts  BankAccount[]
  milestones    UsherMilestone[]
  savedJobs     SavedJob[]

  @@map("ushers")
}

model UsherVerification {
  id            String              @id @default(uuid()) @db.Uuid
  usherId       String              @db.Uuid
  usher         Usher               @relation(fields: [usherId], references: [id], onDelete: Cascade)
  method        VerificationMethod  @default(DOCUMENT)
  // Manual-upload flow only (null for biometric, which captures via the provider).
  idDocumentUrl String?
  selfieUrl     String?
  status        VerificationStatus  @default(PENDING)
  reviewedById  String?             @db.Uuid
  reviewedBy    User?               @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  reason        String?
  reasonCode    VerificationRejectReason?
  // Biometric KYC (Dojah). NIN/BVN are sensitive PII — encrypt at rest / store
  // minimal (NDPR §); never log raw. The returned government photo is a storage
  // key (presigned), never inlined. govLookup keeps the raw provider payload.
  provider         String?
  dojahReferenceId String?
  nin              String?
  bvn              String?
  livenessPassed   Boolean?
  faceMatchScore   Float?
  watchListed      Boolean?
  govPhotoKey      String?
  govLookup        Json?
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  // Set when status leaves PENDING (VERIFIED/REJECTED). Drives NDPR retention
  // (TRD §14): raw ID doc + selfie deleted 90 days after VERIFIED / 30 after
  // REJECTED, leaving only the pass/fail status + reviewer/audit trail.
  reviewedAt       DateTime?          @db.Timestamptz(6)

  @@index([usherId])
  @@index([dojahReferenceId])
  @@map("usher_verifications")
}

// Portfolio work samples shown to clients (max 5, enforced in the API).
// imageUrl holds the server-owned storage key (like UsherVerification), not a URL.
model Photo {
  id        String   @id @default(uuid()) @db.Uuid
  usherId   String   @db.Uuid
  usher     Usher    @relation(fields: [usherId], references: [id], onDelete: Cascade)
  imageUrl  String
  createdAt DateTime @default(now()) @db.Timestamptz(6) // stable upload-order sort

  @@index([usherId])
  @@map("photos")
}

model Availability {
  id      String             @id @default(uuid()) @db.Uuid
  usherId String             @db.Uuid
  usher   Usher              @relation(fields: [usherId], references: [id], onDelete: Cascade)
  date    DateTime           @db.Date
  status  AvailabilityStatus @default(AVAILABLE)

  @@unique([usherId, date])
  @@map("availability")
}

// ---------- marketplace ----------
model Event {
  id            String         @id @default(uuid()) @db.Uuid
  clientId      String         @db.Uuid
  client        Client         @relation(fields: [clientId], references: [id])
  title         String
  venue         String
  state         String? // Nigerian state the event is in; powers usher↔job state matching
  eventDate     DateTime       @db.Date
  startTime     String // "HH:MM"
  endTime       String // "HH:MM" — drives auto-complete (§12)
  category      String
  headcount     Int
  budgetPerHead Int // kobo
  dressCode     String?
  accommodation Accommodation? // required by API when endTime >= 22:00 (late-night safety, visible to staff)
  preferences   Json?
  status        EventStatus    @default(DRAFT)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  applications Application[]
  invitations  Invitation[]
  bookings     Booking[]
  orders       Order[]
  savedBy      SavedJob[]

  @@index([clientId])
  @@index([status])
  @@index([state])
  @@map("events")
}

model Application {
  id        String            @id @default(uuid()) @db.Uuid
  eventId   String            @db.Uuid
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  usherId   String            @db.Uuid
  usher     Usher             @relation(fields: [usherId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(APPLIED)
  createdAt DateTime          @default(now()) @db.Timestamptz(6)

  @@unique([eventId, usherId])
  @@index([usherId])
  @@map("applications")
}

model Invitation {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @db.Uuid
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  usherId   String           @db.Uuid
  usher     Usher            @relation(fields: [usherId], references: [id], onDelete: Cascade)
  status    InvitationStatus @default(SENT)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)

  @@unique([eventId, usherId])
  @@index([usherId])
  @@map("invitations")
}

model SavedJob {
  id        String   @id @default(uuid()) @db.Uuid
  usherId   String   @db.Uuid
  usher     Usher    @relation(fields: [usherId], references: [id], onDelete: Cascade)
  eventId   String   @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([usherId, eventId])
  @@index([usherId])
  @@map("saved_jobs")
}

// ---------- orders / bookings / payments ----------
enum CheckoutState {
  CREATED
  INITIALIZING
  READY
  REVIEW
  EXPIRED
  PAID
  REFUND_PENDING
  REFUNDED
}

model Checkout {
  orderId          String        @id @db.Uuid
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reference        String        @unique
  email            String
  authorizationUrl String?
  state            CheckoutState @default(CREATED)
  attemptedAt      DateTime?      @db.Timestamptz(6)
  expiresAt        DateTime       @db.Timestamptz(6)
  lastCheckedAt    DateTime?      @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  @@index([state, expiresAt])
  @@map("checkouts")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  clientId          String      @db.Uuid
  client            Client      @relation(fields: [clientId], references: [id])
  eventId           String      @db.Uuid
  event             Event       @relation(fields: [eventId], references: [id])
  paystackChargeRef String?
  grossAmount       Int // kobo — Σ per-head over this batch
  status            OrderStatus @default(PENDING)
  createdAt         DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(6)

  bookings Booking[]
  checkout Checkout?

  @@index([clientId])
  @@index([eventId])
  @@map("orders")
}

model Booking {
  id                String            @id @default(uuid()) @db.Uuid
  eventId           String            @db.Uuid
  event             Event             @relation(fields: [eventId], references: [id])
  usherId           String            @db.Uuid
  usher             Usher             @relation(fields: [usherId], references: [id])
  orderId           String?           @db.Uuid
  order             Order?            @relation(fields: [orderId], references: [id])
  amount            Int // kobo, = event.budgetPerHead at confirmation
  status            BookingStatus     @default(PENDING_PAYMENT)
  attendanceMethod  AttendanceMethod?
  arrivalAssertedAt DateTime?         @db.Timestamptz(6)
  checkedInAt       DateTime?         @db.Timestamptz(6)
  completedAt       DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  payment      Payment?
  escrowLedger EscrowLedger[]
  walletLedger WalletLedger[]
  disputes     Dispute[]
  conversation Conversation?
  reviews      Review[]

  @@index([eventId])
  @@index([usherId])
  @@index([orderId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id                  String       @id @default(uuid()) @db.Uuid
  bookingId           String       @unique @db.Uuid
  booking             Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  grossAmount         Int // kobo
  platformFee         Int // kobo (15%)
  usherPayout         Int // kobo (gross − fee)
  paystackChargeRef   String? // denormalized from order
  paystackTransferRef String? // null in wallet model (transfer at withdrawal)
  escrowStatus        EscrowStatus @default(HELD)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  @@map("payments")
}

// Append-only. Source of truth (TRD §6/§25). Never UPDATE/DELETE rows.
model EscrowLedger {
  id           String          @id @default(uuid()) @db.Uuid
  bookingId    String?         @db.Uuid // null for platform-level COMMISSION_SWEEP entries
  booking      Booking?        @relation(fields: [bookingId], references: [id])
  entryType    LedgerEntryType
  amount       Int // kobo, signed
  balanceAfter Int // kobo, running escrow balance for this booking
  paystackRef  String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  @@index([bookingId])
  @@index([entryType])
  @@map("escrow_ledger")
}

// ---------- wallets / withdrawals (v2.1 held-wallet model) ----------
model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  usherId          String   @unique @db.Uuid
  usher            Usher    @relation(fields: [usherId], references: [id], onDelete: Cascade)
  availableBalance Int      @default(0) // kobo, released + withdrawable
  currency         String   @default("NGN")
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  ledger      WalletLedger[]
  withdrawals Withdrawal[]

  @@map("wallets")
}

// Append-only.
model WalletLedger {
  id           String          @id @default(uuid()) @db.Uuid
  walletId     String          @db.Uuid
  wallet       Wallet          @relation(fields: [walletId], references: [id])
  bookingId    String?         @db.Uuid
  booking      Booking?        @relation(fields: [bookingId], references: [id])
  withdrawalId String?         @db.Uuid
  entryType    WalletEntryType
  amount       Int // kobo, signed
  balanceAfter Int // kobo
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)

  @@index([walletId])
  @@index([bookingId])
  @@map("wallet_ledger")
}

model BankAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  usherId               String    @db.Uuid
  usher                 Usher     @relation(fields: [usherId], references: [id], onDelete: Cascade)
  bankCode              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?
  verified              Boolean   @default(false) // account-name resolution matched the usher (§23 Q3)
  bvnVerified           Boolean   @default(false) // BVN match confirmed (flag-gated live check)
  bvnVerifiedAt         DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)

  withdrawals Withdrawal[]

  @@index([usherId])
  @@map("bank_accounts")
}

model Withdrawal {
  id                  String           @id @default(uuid()) @db.Uuid
  walletId            String           @db.Uuid
  wallet              Wallet           @relation(fields: [walletId], references: [id])
  bankAccountId       String           @db.Uuid
  bankAccount         BankAccount      @relation(fields: [bankAccountId], references: [id])
  amount              Int // kobo
  status              WithdrawalStatus @default(REQUESTED)
  paystackTransferRef String?
  failureReason       String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)

  @@index([walletId])
  @@map("withdrawals")
}

// ---------- disputes / messaging / reviews ----------
model Dispute {
  id           String        @id @default(uuid()) @db.Uuid
  bookingId    String        @db.Uuid
  booking      Booking       @relation(fields: [bookingId], references: [id])
  raisedById   String        @db.Uuid
  raisedBy     User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  reason       String
  note         String?
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?       @db.Uuid
  resolvedBy   User?         @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)

  @@index([bookingId])
  @@map("disputes")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id])
  clientId  String   @db.Uuid
  usherId   String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @db.Uuid
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String             @db.Uuid
  sender         User               @relation(fields: [senderId], references: [id])
  contentType    MessageContentType @default(TEXT)
  content        String
  flagged        Boolean            @default(false)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  seenAt         DateTime?          @db.Timestamptz(6)

  @@index([conversationId])
  @@map("messages")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  bookingId  String   @db.Uuid
  booking    Booking  @relation(fields: [bookingId], references: [id])
  reviewerId String   @db.Uuid
  reviewer   User     @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  revieweeId String   @db.Uuid
  reviewee   User     @relation("ReviewSubject", fields: [revieweeId], references: [id])
  rating     Int // 1–5
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([bookingId, reviewerId]) // one review per reviewer per booking (race-safe at the DB)
  @@index([bookingId])
  @@map("reviews")
}

// ---------- infra tables (v2.1) ----------
model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken   String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  targetType String? // entity kind for deep-linking, e.g. "invitation" | "booking"
  targetId   String? // entity id the mobile app routes on when the notification is tapped
  readAt     DateTime?        @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)

  @@index([userId, readAt])
  @@map("notifications")
}

model VerificationCode {
  id         String      @id @default(uuid()) @db.Uuid
  purpose    CodePurpose
  subjectRef String // phone (AUTH) or bookingId (ATTENDANCE)
  codeHash   String
  expiresAt  DateTime    @db.Timestamptz(6)
  consumedAt DateTime?   @db.Timestamptz(6)
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)

  @@index([purpose, subjectRef])
  @@map("verification_codes")
}

model IdempotencyKey {
  key          String   @id
  scope        String
  responseHash String?
  // Stored result of the guarded operation (ids/url/etc.) so a duplicate request
  // resumes with the original outcome instead of an empty response (TRD §10/§25).
  response     Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@map("idempotency_keys")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  // Denormalized actor reference — intentionally NOT a live FK. The audit log is
  // append-only and tamper-evident (entryHash covers actorId), so a referential
  // action like ON DELETE SET NULL mutating this column would silently break the
  // hash chain. Deleting/erasing a user must never touch immutable audit rows
  // (NDPR erasure pseudonymizes the user; the historical actorId is retained).
  actorId   String?  @db.Uuid
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  // Tamper-evident hash chain (TRD §14). seq gives a strict order; entryHash =
  // sha256(canonical(entry) + prevHash). Nullable so rows written before the
  // chain existed are tolerated as legacy (pre-genesis) entries.
  seq       BigInt   @unique @default(autoincrement())
  prevHash  String?
  entryHash String?  @unique

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

/// Singleton pointer to the head of the audit hash chain. Writers SELECT … FOR
/// UPDATE this row to serialize chaining (mirrors the ledger's row-lock idiom).
model AuditChainHead {
  id       Int     @id @default(1)
  lastHash String?

  @@map("audit_chain_head")
}

/// Refresh-token denylist (Phase 9). Logout and refresh-rotation insert the
/// consumed token's jti; /refresh rejects any jti present here. Rows past
/// expiresAt are dropped by the retention purge.
model RevokedToken {
  jti       String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// Consent ledger (NDPR). One row per (user, purpose), flipped on grant/withdraw;
/// withdrawal must stop the corresponding processing (e.g. drop device tokens).
model ConsentRecord {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     ConsentPurpose
  granted     Boolean
  source      ConsentSource  @default(EXPLICIT)
  grantedAt   DateTime       @default(now()) @db.Timestamptz(6)
  withdrawnAt DateTime?      @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  @@unique([userId, purpose])
  @@index([userId])
  @@map("consent_records")
}

/// Record of a user accepting a published legal document version (NDPR publication).
model PolicyAcceptance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentKey String // e.g. "privacy-policy"
  version     String
  acceptedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([userId, documentKey, version])
  @@index([userId])
  @@map("policy_acceptances")
}

// Maker-checker for money moves above a threshold (TRD §15). A maker creates a
// PENDING approval; a different admin (checker) approves to execute.
model Approval {
  id         String         @id @default(uuid()) @db.Uuid
  kind       ApprovalKind
  payload    Json // { bookingId, outcome?, amountKobo, resolution?/reason? }
  amountKobo Int
  makerId    String         @db.Uuid
  maker      User           @relation("ApprovalMaker", fields: [makerId], references: [id])
  checkerId  String?        @db.Uuid
  checker    User?          @relation("ApprovalChecker", fields: [checkerId], references: [id])
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("approvals")
}

// Durable record for a Paystack call paired with a ledger/state write (TRD §10/§17).
// `dedupeKey` is the logical idempotency unit — its unique constraint is the claim
// that prevents a concurrent retry from firing the provider twice; `status` lets a
// crash between the provider call and the ledger write be resumed by the recovery
// job. This is orchestration metadata only: it is NOT a ledger row and does not
// affect the §17 reconciliation formula.
model PaymentOperation {
  id          String          @id @default(uuid()) @db.Uuid
  kind        PaymentOpKind
  dedupeKey   String          @unique
  providerRef String?         @unique // deterministic Paystack reference (transfers/sweeps)
  status      PaymentOpStatus @default(PENDING)
  payload     Json // params needed to resume the operation
  attempts    Int             @default(0)
  lastError   String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@map("payment_operations")
}

// ---------- rewards / milestones (usher loyalty) ----------
// Admin-configurable reward tiers. An usher unlocks a tier once their lifetime
// completed-job count reaches `threshold`. BADGE rewards auto-fulfil on unlock;
// PHYSICAL rewards (dress, iPhone) wait on an admin fulfilment action.
model MilestoneTier {
  id          String     @id @default(uuid()) @db.Uuid
  threshold   Int        @unique // completed jobs required to unlock
  name        String
  rewardType  RewardType
  description String?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  milestones UsherMilestone[]

  @@map("milestone_tiers")
}

// One row per (usher, tier) the usher has reached. Unique pair makes the
// unlock idempotent under the concurrent completion paths.
model UsherMilestone {
  id            String          @id @default(uuid()) @db.Uuid
  usherId       String          @db.Uuid
  usher         Usher           @relation(fields: [usherId], references: [id], onDelete: Cascade)
  tierId        String          @db.Uuid
  tier          MilestoneTier   @relation(fields: [tierId], references: [id])
  status        MilestoneStatus @default(UNLOCKED)
  unlockedAt    DateTime        @default(now()) @db.Timestamptz(6)
  fulfilledAt   DateTime?       @db.Timestamptz(6)
  fulfilledById String?         @db.Uuid // admin who fulfilled (PHYSICAL)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)

  @@unique([usherId, tierId])
  @@index([status])
  @@map("usher_milestones")
}
